Meta.DisplayName=Alien Arena: Warriors Of Mars (TeamKit)
Meta.Description=Serveur dedie d'Alien Arena: Warriors Of Mars, le FPS arena libre et gratuit de COR Entertainment (moteur CRX derive de Quake 2). Derniere version officielle telechargee a l'Update depuis github.com/alienarena/alienarena (environ 1,2 Go, 20 cartes) puis serveur dedie compile dans le conteneur (environ une minute) : COR ne publie aucun binaire Linux. Reglages en francais : nom, message d'accueil, mode (match a mort seul ou en equipes, capture du drapeau, tactique, duel), variantes d'armes (instagib, rocket arena, excessive...) et mutateurs, cartes et rotation, bots, liste publique, mot de passe, RCON. Un seul port, 27910 en UDP. Joueurs et chat visibles dans AMP, console d'AMP branchee sur le serveur (status, kick, map, sv addbot...).
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-AlienArena
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/alienarena/alienarena/7.72.3/unix_dist/alien-arena.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=alienarenaconfig.json
Meta.MetaConfigManifest=alienarenametaconfig.json
Meta.ConfigRoot=alienarena.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=COR Entertainment ne publie aucun binaire Linux d'Alien Arena : le serveur dedie est compile a l'Update dans le conteneur. gcc, make, libc6-dev, pkg-config et zlib1g-dev sont installes par ExtraContainerPackages (le serveur seul n'a besoin d'aucune bibliotheque graphique ni sonore).
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["gcc","make","libc6-dev","pkg-config","zlib1g-dev"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=1e6f4d0e-de6d-4a81-8e92-85136d88c957
Meta.ImportableExtensions=[]
